{
  "name": "siliconskunk",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Office Camp PoC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "migrate": "node-pg-migrate up --migrations-dir db/migrations --tsconfig tsconfig.base.json --envPath .env",
    "seed": "ts-node --project tsconfig.base.json --transpile-only scripts/dev/seed.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  }
}
