{
  "name": "siliconskunk",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Office Camp PoC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "migrate": "node-pg-migrate up --migrations-dir db/migrations --tsconfig tsconfig.base.json --envPath .env",
    "seed": "ts-node --project tsconfig.base.json --transpile-only scripts/dev/seed.ts",
    "start:api": "ts-node --project tsconfig.base.json --transpile-only src/api/server.ts",
    "build:frontend": "vite build",
    "dev:frontend": "vite",
    "typecheck:frontend": "tsc --project frontend/tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.12.0",
    "pg-boss": "^10.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.5"
  }
}
